boot.oos.result
BOOT_eval_oos <- function(DT.list, beta.true, BOOT.ITER, train_prop = 0.7) {
out <- lapply(DT.list, function(DT) {
n <- nrow(DT)
train_id <- sample.int(n, floor(train_prop * n))
DT_train <- DT[train_id, , drop = FALSE]
DT_test  <- DT[-train_id, , drop = FALSE]
theta_test <- cor(DT_test)
R2oos.true <- computeRsq_beta(beta.true, theta_test)
empR2oosdist <- vapply(seq_len(BOOT.ITER), function(b) {
boot_id <- sample.int(
nrow(DT_train),
nrow(DT_train),
replace = TRUE
)
theta_train <- cor(DT_train[boot_id, , drop = FALSE])
betahat_train <- estimate_beta(theta_train)
computeRsq_beta(betahat_train, theta_test)
}, numeric(1))
boot.ci <- unname(
quantile(empR2oosdist, c(0.025, 0.975))
)
c(
coverage = as.numeric(
R2oos.true >= boot.ci[1] &
R2oos.true <= boot.ci[2]
),
width = boot.ci[2] - boot.ci[1]
)
})
out <- do.call(rbind, out)
c(
coverage.boot.oos = mean(out[, "coverage"]),
width.boot.oos    = mean(out[, "width"])
)
}
boot.oos.result <- parallel::mclapply(
seq_len(nrow(param.m)),
function(i) {
BOOT_eval_oos(
DT.list = param.m$DT.list[[i]],
beta.true = param.m$beta_value[[i]],
BOOT.ITER = BOOT.ITER,
train_prop = 0.7
)
},
mc.cores = ncores,
mc.preschedule = FALSE
)
boot.oos.result
out2<- copy(param.m[,.(scenarioID, R2true, phi, ss, p, beta_value)])
out2[, `:=`(
coverage.boot.oos = boot.oos.result[, "coverage.boot.oos"],
width.boot.oos    = boot.oos.result[, "width.boot.oos"]
)]
boot.oos.result
boot.oos.result <- rbindlist(boot.oos.result)
boot.oos.result <- do.call(rbind, boot.oos.result)
boot.oos.result
out2[, `:=`(
coverage.boot.oos = boot.oos.result[, "coverage.boot.oos"],
width.boot.oos    = boot.oos.result[, "width.boot.oos"]
)]
out2
perturbR_eval_oos <- function(DT.train, DT.test, beta.true, nchain) {
out <- Map(function(train, test) {
theta_train <- cor(train)
theta_test  <- cor(test)
# replicate-specific true OOS R2
R2oos.true <- computeRsq_beta(
beta = beta.true,
theta = theta_test
)
# Perturb training correlation matrix
thetacloud <- make_mcmc(
S = theta_train,
asy.n = nrow(train),
NCHAIN = nchain,
alpha = 0.05
)
# theta_train uncertainty -> beta_hat -> OOS R2
empR2oosdist <- vapply(seq_len(nchain), function(i) {
beta_i <- estimate_beta(thetacloud[, , i])
computeRsq_beta(
beta = beta_i,
theta = theta_test
)
}, numeric(1))
perturbR.ci <- unname(
quantile(empR2oosdist, c(0, 1))
)
c(
coverage = as.numeric(
R2oos.true >= perturbR.ci[1] &
R2oos.true <= perturbR.ci[2]
),
width = perturbR.ci[2] - perturbR.ci[1]
)
}, DT.train, DT.test)
out <- do.call(rbind, out)
c(
coverage.perturbR.oos = mean(out[, "coverage"]),
width.perturbR.oos    = mean(out[, "width"])
)
}
perturbR.oos.result <- parallel::mclapply(
seq_len(nrow(param.m)),
function(i) {
perturbR_eval_oos(
DT.train = param.m$DT.train[[i]],
DT.test = param.m$DT.test[[i]],
beta.true = param.m$beta_value[[i]],
nchain = nchain
)
},
mc.cores = 8,
mc.preschedule = FALSE
)
perturbR.oos.result <- do.call(rbind, perturbR.oos.result)
perturbR.oos.result
